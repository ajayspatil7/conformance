# Copy to .env (never commit .env). Keys come only from environment variables.
OPENROUTER_API_KEY=
CONFORMANCE_BUDGET_USD=60
CONFORMANCE_MAX_CONCURRENCY=4
# Client-side request cap per minute (0 = none). :free models are capped at 20 automatically.
CONFORMANCE_MAX_RPM=0
# AWS credits available for the human-operated reference endpoint / lab (tracking only).
CONFORMANCE_AWS_CREDITS_USD=80
# Vercel AI Gateway (cross-check route). Separate $5 budget, tracked in data/gateway_spend.jsonl.
AI_GATEWAY_API_KEY=
CONFORMANCE_GATEWAY_BUDGET_USD=5
